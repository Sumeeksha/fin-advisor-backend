# ─────────────────────────────────────────────
#  Financial Advisory App — Environment Config
# ─────────────────────────────────────────────

# ── Alpha Vantage ────────────────────────────
# Sign up FREE at: https://www.alphavantage.co/support/#api-key
# Takes ~30 seconds. No credit card required.
# Free tier: 25 requests/day, 5 requests/minute
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_KEY_HERE

# ── Finnhub ──────────────────────────────────
# Sign up FREE at: https://finnhub.io/register
# Takes ~1 minute. No credit card required.
# Free tier: 60 requests/minute, real-time US stock quotes (15-min delayed)
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE

# ── Financial Modeling Prep (FMP) ────────────
# Sign up FREE at: https://financialmodelingprep.com/register
# Takes ~1 minute. No credit card required.
# Free tier: 250 requests/day, fundamentals + quotes
FMP_API_KEY=YOUR_FMP_KEY_HERE

# ── App Config ───────────────────────────────
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# NOTE: yfinance (Yahoo Finance) requires NO API key and works out of the box.
# The app is fully functional with just yfinance. The other keys enhance
# real-time data quality and add news feeds.
