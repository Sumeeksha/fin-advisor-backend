# ─────────────────────────────────────────────
#  Financial Advisory App — Environment Config
# ─────────────────────────────────────────────

# ── Alpha Vantage ────────────────────────────
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_KEY_HERE

# ── Finnhub ──────────────────────────────────
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE

# ── Financial Modeling Prep (FMP) ────────────
FMP_API_KEY=YOUR_FMP_KEY_HERE

# ── Multi-LLM Provider API Keys (Optional) ───
# OpenAI (GPT-4o)
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE

# Google Gemini (Gemini 1.5 Pro)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# Anthropic Claude (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE

# DeepSeek (DeepSeek V3 / R1)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY_HERE

# HuggingFace (FinGPT / FinMA)
HF_TOKEN=YOUR_HF_TOKEN_HERE

# ── App Config ───────────────────────────────
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# NOTE: The app is fully functional with deterministic fallbacks when API keys are absent.
# Adding keys above enables live multi-provider LLM narrative synthesis.
